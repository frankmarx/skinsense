# Dependency directories
node_modules/
jspm_dependencies/
venv/
.venv/
env/
ENV/

# Build outputs
dist/
build/
*.egg-info/
__pycache__/
*.py[cod]
*$py.class

# Environment variables (Secrets) - never commit real env files
.env
.env.local
.env.test
.env.development
.env.production
.env.*.local

# IDEs and Editors
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Chalice specific
.chalice/config.json # Optional: usually kept, but sometimes ignored if local-only secrets are here. Keeping it tracked by default.
*/.chalice/deployed/*
*/.chalice/deployments/*
